# Secret scan of the staged changes before every commit, with the same rules as CI (.gitleaks.toml), so a finding is
# fixed before it enters history instead of being allowlisted after. Install once per clone (every worktree shares it):
#   git config core.hooksPath .githooks
# Gitleaks comes from PATH or $GITLEAKS; the version CI pins is in .github/workflows/gitleaks.yml.
set -euo pipefail

bin="${GITLEAKS:-$(command -v gitleaks || true)}"
if [ -z "$bin" ]; then
  echo "pre-commit: gitleaks not found. Install the version pinned in .github/workflows/gitleaks.yml and put it on PATH" >&2
  echo "  (or set GITLEAKS to its path). The commit is stopped so no unscanned change enters history." >&2
  exit 1
fi

root="$(git rev-parse --show-toplevel)"
if ! "$bin" git "$root" --pre-commit --staged --config "$root/.gitleaks.toml" --redact=100 --no-banner --exit-code=1; then
  echo "pre-commit: gitleaks found a possible secret in the staged changes (above). Remove or reword it and commit again;" >&2
  echo "  an allowlist entry in .gitleaksignore needs the owner's approval." >&2
  exit 1
fi
