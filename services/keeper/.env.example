# Bot runner configuration (services/keeper/DESIGN.md). Names only; never commit values. One runner instance serves one
# chain: every integration of its release manifest, each with its own LiquidationBot.

# The chain's verified release manifest (contracts/deployments/verified/<network>-<release>.json).
AVANA_MANIFEST=

# The LiquidationBot's settings (packages/liquidator/README.md). The chain ID must be the manifest's. The AaveAdapters,
# LiquidationModules, debt reserves and the FlashLiquidator this signer operates come from the manifest.
LIQUIDATION_BOT_RPC_URL=
LIQUIDATION_BOT_CHAIN_ID=
# Optional flash path: SwapRouter02 and token:feeTier per pool token; required when the manifest names a
# FlashLiquidator whose operator is this signer.
LIQUIDATION_BOT_SWAP_ROUTER=
LIQUIDATION_BOT_SWAP_LEGS=
LIQUIDATION_BOT_MAX_TOP_UP=
LIQUIDATION_BOT_PROFIT_SLIPPAGE_BPS=
# Milliseconds between passes (4000 by default).
LIQUIDATION_BOT_POLL_MS=
# The signer: an encrypted Foundry keystore (`cast wallet new` or `cast wallet import`) and the file holding its
# password, both outside the repository. A variable named like a private key, mnemonic, seed phrase or password is
# refused. The signer is the keeper the RiskModules register (`addKeeper`) and the wallet 11-fund-keepers tops up.
LIQUIDATION_BOT_KEYSTORE=
LIQUIDATION_BOT_PASSWORD_FILE=

# The indexer's bot stream (services/indexer/EXPORT.md, "Keeper stream"); without both, the bots discover accounts over
# RPC. The key file holds id:base64secret, this runner's entry in the indexer's INDEXER_EXPORT_KEYS.
KEEPER_INDEXER_URL=
KEEPER_INDEXER_KEY_FILE=

# The monitoring service: this instance's name there (one of MONITOR_KEEPER_INSTANCES) and the file holding its bearer
# token (MONITOR_KEEPER_TOKEN_<NAME>). Without all three, alerts are only logged.
KEEPER_MONITOR_URL=
KEEPER_MONITOR_INSTANCE=
KEEPER_MONITOR_TOKEN_FILE=

# Kill switch: the persisted halt flag, and the mutual-TLS endpoint that sets it (all four or none).
KEEPER_HALT_STATE_PATH=
KEEPER_KILL_SWITCH_PORT=
KEEPER_KILL_SWITCH_TLS_CERT=
KEEPER_KILL_SWITCH_TLS_KEY=
KEEPER_KILL_SWITCH_CLIENT_CA=

# Prometheus text metrics on GET /metrics; unset leaves the endpoint off.
KEEPER_METRICS_PORT=
