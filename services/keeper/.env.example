# Keeper configuration (services/README.md, Keeper > Configuration). Names only; never commit values.
# RPC names follow the contracts: RPC_<CHAIN>, with a suffix for each extra endpoint of the same chain.
# The fork tests (npm run test:fork, test/fork/) read RPC_MAINNET and RPC_BASE only, at pinned blocks, so each needs an
# archive endpoint; a suite whose variable is unset is reported as skipped and `npm test` stays offline.

# production (Ethereum and Base), testnet (Sepolia and Base Sepolia) or local (anvil 31337, for deployment
# rehearsals only).
KEEPER_NETWORK_SET=testnet

RPC_MAINNET=
RPC_MAINNET_FALLBACK=
RPC_MAINNET_WS=
RPC_MAINNET_PRIVATE=

RPC_BASE=
RPC_BASE_FALLBACK=
RPC_BASE_WS=
RPC_BASE_PRIVATE=

RPC_SEPOLIA=
RPC_SEPOLIA_FALLBACK=
RPC_SEPOLIA_WS=
RPC_SEPOLIA_PRIVATE=

RPC_BASE_SEPOLIA=
RPC_BASE_SEPOLIA_FALLBACK=
RPC_BASE_SEPOLIA_WS=
RPC_BASE_SEPOLIA_PRIVATE=

RPC_ANVIL=
RPC_ANVIL_FALLBACK=
RPC_ANVIL_WS=

# Signer key IDs in the cloud KMS or HSM; the key never leaves it. Unset means observe-only on that chain.
KEEPER_KMS_KEY_ID_MAINNET=
KEEPER_KMS_KEY_ID_BASE=
KEEPER_KMS_KEY_ID_SEPOLIA=
KEEPER_KMS_KEY_ID_BASE_SEPOLIA=
# Local anvil rehearsal only (refused on every other network set): an encrypted keystore (`cast wallet import`) and
# the file holding its password, outside the repository. No raw key is read from the environment.
KEEPER_LOCAL_KEYSTORE_ANVIL=
KEEPER_LOCAL_KEYSTORE_PASSWORD_FILE=

# Fee ceiling per chain, in wei: the most one transaction may cost at worst (gas limit x max fee, plus the L1 data fee
# on Base). A send or replacement above it is not made and pages (M-17). Required on every chain with a signer.
KEEPER_GAS_CEILING_WEI_MAINNET=
KEEPER_GAS_CEILING_WEI_BASE=
KEEPER_GAS_CEILING_WEI_SEPOLIA=
KEEPER_GAS_CEILING_WEI_BASE_SEPOLIA=

# Largest single debtToCover each chain's caps allow, per debt asset, as asset:amount in the asset's base units,
# comma-separated (from each listing's REQ-FLASH-008 sizing). M-16 compares the funding Safe's free float with it
# (150 % / 100 %), M-17 the Aave V3 Pool's idle liquidity (2x / 1x). A debt asset without an entry warns (M-16).
KEEPER_LARGEST_DEBT_TO_COVER_MAINNET=
KEEPER_LARGEST_DEBT_TO_COVER_BASE=
KEEPER_LARGEST_DEBT_TO_COVER_SEPOLIA=
KEEPER_LARGEST_DEBT_TO_COVER_BASE_SEPOLIA=

# The signer's expected daily gas spend in wei: M-17 warns below 3 days and pages below 1 day of the median measured
# daily spend, never taken below this value. Required on every chain with a signer.
KEEPER_GAS_DAILY_SPEND_WEI_MAINNET=
KEEPER_GAS_DAILY_SPEND_WEI_BASE=
KEEPER_GAS_DAILY_SPEND_WEI_SEPOLIA=
KEEPER_GAS_DAILY_SPEND_WEI_BASE_SEPOLIA=

# Fee classes (keeper DESIGN.md, Fees), per chain, in wei. Urgent (liquidations, breaker and configuration pokes with a
# change, oracle pokes while not Live with a change): tip = p90 of the last 5 blocks, at least KEEPER_MIN_TIP_URGENT
# (unset: 1 gwei). Scheduled (checkpoint and feed-round oracle pokes): tip = KEEPER_MIN_TIP_SCHEDULED (unset: 0.5 gwei,
# 0.01 gwei on Base and Base Sepolia). Lazy (settlePending): tip = KEEPER_MIN_TIP_LAZY (unset: 0.1 gwei, 0.001 gwei on
# Base) while the base fee is at most KEEPER_LAZY_BASEFEE_MAX (unset: 1 gwei, 0.05 gwei on Base); above it, it waits up
# to KEEPER_LAZY_MAX_WAIT seconds from when it first fell due (unset: 3600), then goes at scheduled fees. Tips must not
# rise from urgent to lazy. The defaults are starting points until the inclusion-delay measurement sets them.
KEEPER_MIN_TIP_URGENT_MAINNET=
KEEPER_MIN_TIP_SCHEDULED_MAINNET=
KEEPER_MIN_TIP_LAZY_MAINNET=
KEEPER_LAZY_BASEFEE_MAX_MAINNET=
KEEPER_LAZY_MAX_WAIT_MAINNET=
KEEPER_MIN_TIP_URGENT_BASE=
KEEPER_MIN_TIP_SCHEDULED_BASE=
KEEPER_MIN_TIP_LAZY_BASE=
KEEPER_LAZY_BASEFEE_MAX_BASE=
KEEPER_LAZY_MAX_WAIT_BASE=
KEEPER_MIN_TIP_URGENT_SEPOLIA=
KEEPER_MIN_TIP_SCHEDULED_SEPOLIA=
KEEPER_MIN_TIP_LAZY_SEPOLIA=
KEEPER_LAZY_BASEFEE_MAX_SEPOLIA=
KEEPER_LAZY_MAX_WAIT_SEPOLIA=
KEEPER_MIN_TIP_URGENT_BASE_SEPOLIA=
KEEPER_MIN_TIP_SCHEDULED_BASE_SEPOLIA=
KEEPER_MIN_TIP_LAZY_BASE_SEPOLIA=
KEEPER_LAZY_BASEFEE_MAX_BASE_SEPOLIA=
KEEPER_LAZY_MAX_WAIT_BASE_SEPOLIA=

# Rolling 24 h budget in wei of the scheduled and lazy classes; a class at its budget stops sending and pages (M-32).
# Urgent has none. Unset: 3 (scheduled) and 1 (lazy) times KEEPER_GAS_DAILY_SPEND_WEI of the chain.
KEEPER_DAILY_BUDGET_WEI_SCHEDULED_MAINNET=
KEEPER_DAILY_BUDGET_WEI_LAZY_MAINNET=
KEEPER_DAILY_BUDGET_WEI_SCHEDULED_BASE=
KEEPER_DAILY_BUDGET_WEI_LAZY_BASE=
KEEPER_DAILY_BUDGET_WEI_SCHEDULED_SEPOLIA=
KEEPER_DAILY_BUDGET_WEI_LAZY_SEPOLIA=
KEEPER_DAILY_BUDGET_WEI_SCHEDULED_BASE_SEPOLIA=
KEEPER_DAILY_BUDGET_WEI_LAZY_BASE_SEPOLIA=

# The standby instance's signer on each chain (set on the primaries) and its minimum gas balance in wei: below it, M-33
# warns. Unset minimum: 3 days of KEEPER_GAS_DAILY_SPEND_WEI. Fund both signers from the feeRecipient treasury Safe.
KEEPER_STANDBY_SIGNER_MAINNET=
KEEPER_STANDBY_MIN_BALANCE_WEI_MAINNET=
KEEPER_STANDBY_SIGNER_BASE=
KEEPER_STANDBY_MIN_BALANCE_WEI_BASE=
KEEPER_STANDBY_SIGNER_SEPOLIA=
KEEPER_STANDBY_MIN_BALANCE_WEI_SEPOLIA=
KEEPER_STANDBY_SIGNER_BASE_SEPOLIA=
KEEPER_STANDBY_MIN_BALANCE_WEI_BASE_SEPOLIA=

# Chainlink feed of the gas token in USD per chain, used only to value liquidation rewards for the small-account spend
# metric (gas spent on liquidations whose reward did not cover it). Unset: that metric is not reported.
KEEPER_NATIVE_USD_FEED_MAINNET=
KEEPER_NATIVE_USD_FEED_BASE=
KEEPER_NATIVE_USD_FEED_SEPOLIA=
KEEPER_NATIVE_USD_FEED_BASE_SEPOLIA=

# Monitoring service (services/monitor). Unset: alerts are log lines only. Set: each chain needs this keeper's
# instance name there (one of MONITOR_KEEPER_INSTANCES) and that instance's token (MONITOR_KEEPER_TOKEN_<NAME>).
KEEPER_MONITOR_URL=
KEEPER_MONITOR_INSTANCE_MAINNET=
KEEPER_MONITOR_TOKEN_MAINNET=
KEEPER_MONITOR_INSTANCE_BASE=
KEEPER_MONITOR_TOKEN_BASE=

# observe (scan, size and log only) or active.
KEEPER_MODE=observe
# primary or standby; the standby leaves KEEPER_SHARD and KEEPER_SHARD_COUNT unset.
KEEPER_ROLE=primary
KEEPER_SHARD=
KEEPER_SHARD_COUNT=

# Authenticated halt endpoint (mutual TLS) and metrics, on different ports.
KEEPER_KILL_SWITCH_PORT=
KEEPER_KILL_SWITCH_TLS_CERT=
KEEPER_KILL_SWITCH_TLS_KEY=
KEEPER_KILL_SWITCH_CLIENT_CA=
# File that holds the halt flag, so a halt survives a restart.
KEEPER_HALT_STATE_PATH=
KEEPER_METRICS_PORT=

# Indexer event stream (the private network address of services/indexer) and the keeper's key for it, as
# id:base64secret (at least 32 bytes); the same entry is listed in the indexer's INDEXER_EXPORT_KEYS.
KEEPER_INDEXER_URL=
KEEPER_INDEXER_KEY=
# Seconds an account may stay known to only one discovery source (indexer stream or RPC log backfill) before M-30
# pages; it warns at once. Unset: 3600.
KEEPER_DISCOVERY_MISMATCH_PAGE_SECONDS=
# Seconds of block time between checks of the slow jobs: the instance's status, pending settlement, configuration
# pokes, the gas vault, scheduled oracle pokes and the funding reads (M-16, M-17, M-33; their alerts are posted again
# at every head in between). Liquidations, breaker pokes and oracles that are not Live are checked at every head.
# 0 checks everything at every head. Unset: 60.
KEEPER_SLOW_JOB_SECONDS=

# Verified manifest of each chain (deployments/verified/), comma-separated.
AVANA_MANIFEST=
