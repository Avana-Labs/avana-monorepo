# Keeper configuration (services/README.md, Keeper > Configuration). Names only; never commit values.
# RPC names follow the contracts: RPC_<CHAIN>, with a suffix for each extra endpoint of the same chain.

# production (Ethereum and Base), testnet (Sepolia and Base Sepolia) or local (anvil 31337, for deployment
# rehearsals only).
KEEPER_NETWORK_SET=testnet

RPC_MAINNET=
RPC_MAINNET_FALLBACK=
RPC_MAINNET_WS=
RPC_MAINNET_PRIVATE=

RPC_BASE=
RPC_BASE_FALLBACK=
RPC_BASE_WS=
RPC_BASE_PRIVATE=

RPC_SEPOLIA=
RPC_SEPOLIA_FALLBACK=
RPC_SEPOLIA_WS=
RPC_SEPOLIA_PRIVATE=

RPC_BASE_SEPOLIA=
RPC_BASE_SEPOLIA_FALLBACK=
RPC_BASE_SEPOLIA_WS=
RPC_BASE_SEPOLIA_PRIVATE=

RPC_ANVIL=
RPC_ANVIL_FALLBACK=
RPC_ANVIL_WS=

# Signer key IDs in the cloud KMS or HSM; the key never leaves it. Unset means observe-only on that chain.
KEEPER_KMS_KEY_ID_MAINNET=
KEEPER_KMS_KEY_ID_BASE=
KEEPER_KMS_KEY_ID_SEPOLIA=
KEEPER_KMS_KEY_ID_BASE_SEPOLIA=

# Fee ceiling per chain, in wei: the most one transaction may cost at worst (gas limit x max fee, plus the L1 data fee
# on Base). A send or replacement above it is not made and pages (M-17). Required on every chain with a signer.
KEEPER_GAS_CEILING_WEI_MAINNET=
KEEPER_GAS_CEILING_WEI_BASE=
KEEPER_GAS_CEILING_WEI_SEPOLIA=
KEEPER_GAS_CEILING_WEI_BASE_SEPOLIA=

# observe (scan, size and log only) or active.
KEEPER_MODE=observe
# primary or standby; the standby leaves KEEPER_SHARD and KEEPER_SHARD_COUNT unset.
KEEPER_ROLE=primary
KEEPER_SHARD=
KEEPER_SHARD_COUNT=

# Authenticated halt endpoint (mutual TLS) and metrics, on different ports.
KEEPER_KILL_SWITCH_PORT=
KEEPER_KILL_SWITCH_TLS_CERT=
KEEPER_KILL_SWITCH_TLS_KEY=
KEEPER_KILL_SWITCH_CLIENT_CA=
# File that holds the halt flag, so a halt survives a restart.
KEEPER_HALT_STATE_PATH=
KEEPER_METRICS_PORT=

# Indexer event stream (the private network address of services/indexer) and the keeper's key for it, as
# id:base64secret (at least 32 bytes); the same entry is listed in the indexer's INDEXER_EXPORT_KEYS.
KEEPER_INDEXER_URL=
KEEPER_INDEXER_KEY=

# Verified manifest of each chain (deployments/verified/), comma-separated.
AVANA_MANIFEST=
