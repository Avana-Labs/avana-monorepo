# Faucet configuration (services/faucet/README.md). Names only; never commit values.

# fork: the local Ethereum and Base forks (cheatcodes, no key). testnet: Sepolia and Base Sepolia (mints the test tokens
# from the signer below).
FAUCET_CHAIN_KIND=fork

# Chain ids the faucet accepts; any other chain is refused, and Ethereum (1) and Base (8453) are rejected outright.
FAUCET_CHAIN_IDS=31337,31338

# RPC of each local fork chain. At least one.
FAUCET_RPC_ETHEREUM=http://127.0.0.1:8545
FAUCET_RPC_BASE=http://127.0.0.1:8546
# Each chain's release manifest: the token addresses (group "token", by symbol) and the "<SYMBOL> / USD (primary)" feeds
# that price the Base USD lines. A token or feed the manifest lacks fails that line only, by name.
FAUCET_MANIFEST_ETHEREUM=
FAUCET_MANIFEST_BASE=

# Listens on 127.0.0.1 only.
FAUCET_PORT=42080

# Where the record of given grants is kept.
FAUCET_DATA_DIR=.faucet

# Test networks only: the test tokens' minter (the world deployer), an encrypted Foundry keystore and its password file,
# both outside the repository. A fork faucet refuses them.
FAUCET_SIGNER_KEYSTORE=
FAUCET_SIGNER_PASSWORD_FILE=
# Test networks only: test ETH a wallet is topped up to from the signer (0, the default, gives none).
FAUCET_GAS_ETH=0
