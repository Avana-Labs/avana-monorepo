# Faucet configuration (services/faucet/README.md). Names only; never commit values.

# fork: the local Ethereum and Base forks (cheatcodes, no key). testnet: Sepolia, not built yet (refuses).
FAUCET_CHAIN_KIND=fork

# Chain ids the faucet accepts; any other chain is refused, and Ethereum (1) and Base (8453) are rejected outright.
FAUCET_CHAIN_IDS=31337,31338

# RPC of each local fork chain. At least one.
FAUCET_RPC_ETHEREUM=http://127.0.0.1:8545
FAUCET_RPC_BASE=http://127.0.0.1:8546

# Listens on 127.0.0.1 only.
FAUCET_PORT=42080

# Where the record of given grants is kept.
FAUCET_DATA_DIR=.faucet
