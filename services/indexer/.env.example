# Indexer configuration (services/indexer/README.md). Names only; never commit values.
# RPC names are the repository's: RPC_<CHAIN>, with a suffix for each extra endpoint of the same chain.

# production (Ethereum and Base) or testnet (Sepolia and Base Sepolia).
INDEXER_NETWORK_SET=testnet

RPC_MAINNET=
RPC_MAINNET_FALLBACK=
RPC_MAINNET_WS=
RPC_BASE=
RPC_BASE_FALLBACK=
RPC_BASE_WS=
RPC_SEPOLIA=
RPC_SEPOLIA_FALLBACK=
RPC_SEPOLIA_WS=
RPC_BASE_SEPOLIA=
RPC_BASE_SEPOLIA_FALLBACK=
RPC_BASE_SEPOLIA_WS=

# Verified manifest of each chain (deployments/verified/), comma-separated.
AVANA_MANIFEST=

# PostgreSQL. Each deployment uses its own schema; a reindex starts a new schema and switches the views.
DATABASE_URL=
DATABASE_SCHEMA=

# Export authentication: HMAC-SHA256 keys as id:base64secret, comma-separated (two during a rotation).
INDEXER_EXPORT_KEYS=
