# Monitoring service configuration (services/monitor/README.md). Names only; never commit values.
# RPC names follow the other services: RPC_<CHAIN> is the primary provider, RPC_<CHAIN>_FALLBACK the second provider
# every page is confirmed on (a different provider, not a second URL of the same one).

# production (Ethereum and Base), testnet (Sepolia and Base Sepolia) or local (anvil 31337).
MONITOR_NETWORK_SET=testnet

# Comma-separated verified release manifests, one per chain.
AVANA_MANIFEST=

RPC_MAINNET=
RPC_MAINNET_FALLBACK=
RPC_BASE=
RPC_BASE_FALLBACK=
RPC_SEPOLIA=
RPC_SEPOLIA_FALLBACK=
RPC_BASE_SEPOLIA=
RPC_BASE_SEPOLIA_FALLBACK=
RPC_ANVIL=
RPC_ANVIL_FALLBACK=

# Seconds between snapshot reads of each chain (default 12).
MONITOR_INTERVAL_SECONDS=

# Delivery channels, name:kind with kind pagerduty, webhook (https only) or log.
MONITOR_CHANNELS=oncall:pagerduty,signers:pagerduty,ops:webhook,log:log
MONITOR_CHANNEL_ONCALL_ROUTING_KEY=
MONITOR_CHANNEL_SIGNERS_ROUTING_KEY=
MONITOR_CHANNEL_OPS_URL=

# Channels of each recipient, comma-separated. Every recipient needs at least one, or the service refuses to start.
# Warns go to the on-call engineer and the signal's responders; pages also to the three page-only recipients below.
MONITOR_ROUTE_ON_CALL=
MONITOR_ROUTE_GOVERNANCE_SAFE_SIGNERS=
MONITOR_ROUTE_EMERGENCY_GUARDIAN_SIGNERS=
MONITOR_ROUTE_AAVE_PROTOCOL_GUARDIAN=
MONITOR_ROUTE_OPERATORS=
MONITOR_ROUTE_EMERGENCY_GUARDIAN=
MONITOR_ROUTE_GUARDIANS=
MONITOR_ROUTE_RISK_PROVIDERS=
MONITOR_ROUTE_GOVERNANCE=
MONITOR_ROUTE_STANDBY_KEEPER=
MONITOR_ROUTE_KEEPER_ON_CALL=
MONITOR_ROUTE_AVANA_LABS=
MONITOR_ROUTE_AAVE_DAO=
MONITOR_ROUTE_AAVE=
MONITOR_ROUTE_COVERAGE_ROLE=
MONITOR_ROUTE_ENGINEERING=
MONITOR_ROUTE_CANCELLERS=
MONITOR_ROUTE_SIGNERS=

# Append-only incident log (EMG-075), one JSON line per notice.
MONITOR_INCIDENT_LOG=

# State file (open alerts, the events cursor, hour windows, last-seen Safes, issuers and frontend), written after every
# round so a restart neither re-sends open alerts nor skips events. Keep it on persistent storage.
MONITOR_STATE_PATH=

# Ingest and status server.
MONITOR_PORT=9470
MONITOR_STATUS_TOKEN=

# Keeper instances that post alerts and heartbeats, name:chain, and one bearer token each
# (MONITOR_KEEPER_TOKEN_<NAME>, the name upper-cased with - as _).
MONITOR_KEEPER_INSTANCES=eth-primary:mainnet,eth-standby:mainnet,base-primary:base,base-standby:base
MONITOR_KEEPER_TOKEN_ETH_PRIMARY=
MONITOR_KEEPER_TOKEN_ETH_STANDBY=
MONITOR_KEEPER_TOKEN_BASE_PRIMARY=
MONITOR_KEEPER_TOKEN_BASE_STANDBY=

# M-23: governance Safes watched per chain, label:chain:address (owners, threshold, guard and modules; any change pages).
MONITOR_SAFES=
# M-29: the Aave Core Hub GHO asset each chain's Avana Hubs are compared with, chain:hub:assetId.
MONITOR_CORE_HUB_GHO=
# M-27: the frontend, https only; MONITOR_FRONTEND_SHA256 is the released page's sha256 (a mismatch pages; without it a
# change warns). MONITOR_FRONTEND_CHAIN picks the chain loop that checks it (the first configured chain by default).
MONITOR_FRONTEND_URL=
MONITOR_FRONTEND_SHA256=
MONITOR_FRONTEND_CHAIN=
