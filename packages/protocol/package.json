{
  "name": "@avana/protocol",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "description": "Avana and Aave V4 ABIs generated from the Foundry build, with the ABI hash the services check against each release manifest; the release manifest schema, producer, verification and contract table.",
  "type": "module",
  "exports": {
    "./abis": "./src/abis/index.ts",
    "./manifest": "./src/manifest/index.ts",
    "./manifest/schema": "./src/manifest/schema.ts",
    "./manifest/sample": "./src/manifest/sample.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "generate": "node scripts/generate-abis.mjs",
    "check-abis": "node scripts/generate-abis.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "manifest": "node src/manifest/cli.ts"
  },
  "dependencies": {
    "viem": "2.57.11"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
