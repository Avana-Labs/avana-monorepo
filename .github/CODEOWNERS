# Avana Labs — Code Owners
# GitHub uses the LAST matching rule. A listed owner must have write access
# (teams must be visible and have write access) for review requests to work.
# CODEOWNERS requests review; branch rulesets must require code-owner approval.
#
# Multiple owners on one line are ALTERNATIVES: approval by one is sufficient.
# Require separate security/deployment approvals via rulesets or dedicated checks.

# Default repository ownership.
*                                      @Avana-Labs/core

# Smart contracts, deployment scripts, tests, and formal verification.
# Narrower sensitive-path overrides appear later.
/contracts/                            @Avana-Labs/contracts
/contracts/security/                   @Avana-Labs/security
/contracts/test/utils/fixtures/ForkConstants.sol @Avana-Labs/contracts @Avana-Labs/security

# Specifications, risk assumptions, and verification evidence.
/spec/                                 @Avana-Labs/contracts
/audit/                                @Avana-Labs/security

# Verified deployment artifacts and generated on-chain address libraries.
# Deployment sign-off is separate from GitHub code review.
/deployments/verified/                 @Avana-Labs/deployers
/packages/protocol/sol/                @Avana-Labs/deployers

# Governance operations and executable governance payloads.
/governance/                            @Avana-Labs/governance

# Off-chain services and shared transport schemas.
# Change these paths when dedicated service-owner teams are established.
/services/                              @Avana-Labs/core
/services/common/                       @Avana-Labs/core
/services/convex/                       @Avana-Labs/core
/services/indexer/                      @Avana-Labs/core
# Keeper actions can affect protocol operations and should receive security review.
/services/keeper/                       @Avana-Labs/security

# CI, repository policy, security documentation and supply-chain controls.
/.github/                               @Avana-Labs/security
/lefthook.yml                          @Avana-Labs/security
/SECURITY.md                           @Avana-Labs/security
/LICENSE                               @Avana-Labs/security
/LICENSING.md                          @Avana-Labs/security
/LICENSES/                             @Avana-Labs/security
/NOTICE                                @Avana-Labs/security
/THIRD_PARTY_LICENSES.md               @Avana-Labs/security
