#
# Environment variables of the production Convex deployment (services/convex/README.md, Configuration). Names only:
# set the values with `npx convex env set` from the cloud's secret store, never in a file.

# The chains the crons run for (services/convex/convex/lib/cronChains.ts). Unset, the deployment schedules no cron.
AVANA_CHAIN_IDS=1,8453

# Convex's own RPC pair per chain (not the indexer's: it checks the export's block hashes against them).
RPC_MAINNET=
RPC_MAINNET_FALLBACK=
RPC_BASE=
RPC_BASE_FALLBACK=

# The indexer's export, behind the TLS endpoint restricted to Convex's egress (infra/hosts.yaml).
INDEXER_EXPORT_URL=
INDEXER_EXPORT_KEY_ID=
# base64, at least 32 bytes; listed with its key ID in the indexer's INDEXER_EXPORT_KEYS.
INDEXER_EXPORT_SECRET=

# Listing metadata files, fetched by their keccak256 (the timelock salt).
LISTING_CONTENT_URL=
POOL_HISTORY_DAYS=90

# Web app server ↔ Convex: SIWE issuer, session and rate-limit secrets (at least 32 characters each).
SIWE_JWT_ISSUER=
CONVEX_SESSION_SECRET=
CONVEX_RATE_LIMIT_SECRET=

# Incentives; empty uses https://api.merkl.xyz.
MERKL_API_URL=

# Ask AI.
OPENAI_API_KEY=
ASK_AI_MODEL=
ASK_AI_FAST_MODEL=
ASK_AI_DEFILLAMA_POOLS_URL=
ASK_AI_DEFILLAMA_POOLS_LIMIT=
