    "src/policy/parameter-store/ParameterStoreRisk.sol": [
      {
        "function": "_requireAddCap",
        "branch": "floor == 0 reverts AddCapTooSmall",
        "reason": "Every written stressFloorUsd is > 0 (setInitialMarketCaps and setStressFloorUsd refuse 0), and on a market whose caps were never written the callers fail first: loosenMarketUsdCap at its step (value x 10^4 <= 0 x 15,000) and loosenTopUpSliceUsd at value > cap = 0. The check keeps the division safe if a later caller or upgrade reaches it with an unwritten floor.",
        "tests": "TEST-272 test_TEST_272_initialCaps and test_TEST_272_stressFloor (zero floor refused), TEST-225 test_TEST_225_marketCapStepAndAddCap (step and slice bounds)"
      }
    ],
    "src/oracle/lp-oracle/LPOracleConfig.sol": [
      {
        "function": "_loadSeed",
        "branch": "token count or marketId mismatch",
        "reason": "checkConfig returns CHECK_TOKENS on the same condition (token count, market id 0 or another market) before _checkAtCurrentQuotes calls _loadSeed, and initialize stores $.tokens and $.marketId from the same configuration it then seeds (LPOracle._storeMarket reverts MarketMismatch otherwise); kept as a defensive check (Josue, 2026-11-11). The check stops being redundant if the initialization or upgrade flow changes (a reinitializer, a migration, or a caller of _loadSeed other than checkConfig and initializeMarket).",
        "tests": "TEST-219 test_TEST_219_checkConfigRefusesAnotherMarketOrTokenCount, test_TEST_219_checkConfigRefusesOtherTokensInPlace, test_TEST_219_marketChecks; TEST-062 test_TEST_062_initializeRefusesAnotherMarketOrTokenList, test_TEST_062_initializeRefusesUnusableMarketData, test_TEST_062_initializeRefusesRepeatedToken"
      }
    ],
    "src/policy/market-registry/MarketRegistryActivationLogic.sol": [
      {
        "function": "_checkOracleAndRoutes",
        "branch": "!listed || !_commonModeHolds(tokens) reverts ActivationCheckFailed(marketId, \"registration\")",
        "reason": "A Registered market's pool tokens were all listed and passed the common-mode guard at listCollateralMarket; the registry has no function that unlists a token, and setPriceSource re-runs the common-mode guard on every market that is not Cancelled or Closed (Registered included) and reverts on failure. So both halves hold at activation; the check is kept as defence in depth for a later upgrade that could change token records. The surviving Gambit mutant on the same loop (fingerprint 5a5e0df0ef1ffe86) is equivalent for the same reason.",
        "tests": "TEST-139 test_TEST_139_firstUnlistedTokenReported and test_TEST_139_commonModeEveryPairing (listing refusals), TEST-231 test_TEST_231_priceSourceChangeGuardsARegisteredMarket (a route change that would break the guard is refused)"
      }
    ],
    "src/policy/market-registry/MarketRegistryHubsLogic.sol": [
      {
        "function": "_removeId",
        "branch": "at == n returns without removing",
        "reason": "removeDebtReserve calls _removeId only for an approved reserve, and enableDebtReserve pushes the id into debtReserveIds in the same write that approves it, so the id is always present when _removeId runs.",
        "tests": "TEST-213 test_TEST_213_removeFirstKeepsTheOrder, test_TEST_213_removeMiddleKeepsTheOrder, test_TEST_213_removeLastKeepsTheOrder, test_TEST_213_removalRefusals (UnknownDebtReserve before any removal)"
      }
    ],
    "src/lens/lens/LensRemoval.sol": [
      {
        "function": "_removalBound",
        "branch": "per == 0 returns 0",
        "reason": "The only caller, _maxRemoval, returns 0 itself when per == 0 or assets == 0 before it calls _removalBound, so per is never 0 there. The check keeps the division by per safe if another caller is added.",
        "tests": "test_TEST_247_maxWithdrawLatestFactorZeroCountsNothing and test_TEST_247_maxWithdrawVaultTokenNotCollateralCountsNothing (Lens.RemovalUncounted: per == 0 and assets == 0 stop in _maxRemoval), test_TEST_247_maxWithdrawIsTheExactAaveBound and test_TEST_247_maxWithdrawSubtractsTheRescueExclusion (Lens.InverseSizing: per > 0 reaches the bound)"
      }
    ],
    "src/lens/lens/LensSizing.sol": [
      {
        "function": "_reaches",
        "branch": "units == 0 returns false",
        "reason": "previewDeleverageTo returns before sizing when the deleverage limit is 0, and _reaches is then called only with hi from _fullRepayUnits (at least 1: limit, or a mid above lo) and with mid = lo + (hi - lo) / 2 while hi - lo > 1, so mid >= lo + 1 >= 1. The check keeps a zero-unit repayment from counting as reaching the target if another caller is added.",
        "tests": "Lens.DeleverageTo (test_TEST_247_deleverageToWithASixDecimalDebt, test_TEST_247_deleverageToFromBelowOneRaisesTheTargetToOne, test_TEST_247_deleverageToBeyondTheRecordIsUnreachable: units >= 1 reach _reaches)"
      }
