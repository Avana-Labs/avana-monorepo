# Copy to contracts/.env and fill in. contracts/.env is gitignored; never commit values.
# The Makefile reads this file with `-include .env`; forge reads it from contracts/ automatically.

# RPC endpoints ([rpc_endpoints] in foundry.toml). Use archive endpoints: fork suites select old
# blocks, and a non-archive RPC fails on state older than its pruning window.
RPC_MAINNET=
RPC_BASE=
RPC_SEPOLIA=
RPC_BASE_SEPOLIA=

# Fork blocks are pinned in test/utils/fixtures/ForkConstants.sol. These override the pins for local
# experiments only; CI never sets them, and TEST-003 fails while an override is in effect.
# MAINNET_FORK_BLOCK=
# BASE_FORK_BLOCK=

# Source verification ([etherscan] in foundry.toml): one Etherscan v2 key covers Ethereum, Base,
# Sepolia and Base Sepolia.
ETHERSCAN_API_KEY=

# Certora Prover (certora/conf/*.conf).
CERTORAKEY=

# Deployer: a Foundry keystore account (`cast wallet import <name> --interactive`) and its address.
# No private key is ever read from the environment.
ACCOUNT_NAME=deployer
SENDER=

# Hardware-wallet deployer (Makefile deploy-ledger-%): derivation index and the Ledger address.
LEDGER_SENDER=
MNEMONIC_INDEX=0

# Release inputs of the deploy scripts (script/README.md): the git tag vX.Y.Z of the commit being
# deployed, which feeds the CREATE2/CREATE3 salts, and the input manifest under ../deployments/.
AVANA_RELEASE=
AVANA_MANIFEST=

# Libraries linked into the aave profile build; set from deployments-local/libraries.env after 01.
# FOUNDRY_LIBRARIES=

# Hostile-component suites on the fork: `fork` selects the fork fixture (test/README.md section 6).
# AVANA_FIXTURE=

# Security-tier budgets read by script/security-slow.sh and script/check-coverage.sh; defaults shown.
# ECHIDNA_TIMEOUT=900
# ECHIDNA_TEST_LIMIT=
# ECHIDNA_HARNESSES=
# MEDUSA_TIMEOUT=900
# MEDUSA_TEST_LIMIT=
# HEVM_SMT_TIMEOUT=300
# HALMOS_LOOP=8
# MUTATE_LAYERS=
# MUTATE_CONTRACTS=
# MUTATE_MUTATORS=
# MUTATE_TIMEOUT=300
# MUTATE_FUZZ_RUNS=256
# NECESSIST_TIMEOUT=300
# COVERAGE_JOBS=2
# COVERAGE_NO_MATCH_TEST=exactCycleCost
