{
  "name": "avana-monorepo",
  "private": true,
  "license": "BUSL-1.1",
  "description": "npm workspace root for the off-chain TypeScript packages: services/common, services/indexer, services/keeper, services/monitor, services/convex and packages/protocol.",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/protocol",
    "services/common",
    "services/indexer",
    "services/keeper",
    "services/monitor",
    "services/convex"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present"
  },
  "overrides": {
    "@graphql-tools/utils": "12.1.0",
    "vite": "8.3.8",
    "@hono/node-server": "2.1.3",
    "drizzle-orm": "0.45.2",
    "glob": "14.0.2",
    "minimatch": {
      ".": "11.0.1",
      "brace-expansion": "5.0.12",
      "@isaacs/nonrecursive-glob-match": "1.0.1"
    }
  }
}
