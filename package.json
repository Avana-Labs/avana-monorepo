{
  "name": "avana-monorepo",
  "private": true,
  "license": "BUSL-1.1",
  "description": "npm workspace root for the off-chain TypeScript packages: services/common, services/indexer, services/keeper, services/monitor, services/convex, packages/protocol and the web app in web/.",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/protocol",
    "services/common",
    "services/indexer",
    "services/keeper",
    "services/monitor",
    "services/convex",
    "web"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present"
  },
  "overrides": {
    "@graphql-tools/utils": "12.1.0",
    "vite": "8.3.8",
    "@hono/node-server": "2.1.3",
    "drizzle-orm": "0.45.2",
    "glob": "14.0.2",
    "minimatch": {
      ".": "11.0.1",
      "brace-expansion": "5.0.12",
      "@isaacs/nonrecursive-glob-match": "1.0.1"
    },
    "@walletconnect/ethereum-provider": "2.26.0",
    "@reown/appkit-wallet": {
      "zod": "4.6.7"
    },
    "@coinbase/cdp-sdk": {
      "zod": "4.6.7"
    },
    "@ai-sdk/provider-utils": "5.0.28",
    "ws": "8.22.2",
    "postcss": "8.5.32",
    "uuid": "11.1.1",
    "axios": "1.21.0",
    "nanoid": "3.3.20",
    "sharp": "0.35.5",
    "socket.io-parser": "4.2.7",
    "browserslist": "4.28.9",
    "undici": "7.30.2",
    "follow-redirects": "1.16.2",
    "postcss-selector-parser": "6.1.5",
    "@humanfs/node": "0.16.8"
  }
}
