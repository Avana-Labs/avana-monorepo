{
  "name": "avana-monorepo",
  "private": true,
  "license": "BUSL-1.1",
  "description": "npm workspace root for the off-chain TypeScript packages: services/common, services/indexer, services/keeper and packages/protocol.",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/protocol",
    "services/common",
    "services/indexer",
    "services/keeper"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present"
  },
  "overrides": {
    "@graphql-tools/utils": "12.1.0",
    "vite": "8.3.8",
    "@hono/node-server": "1.19.17"
  }
}
