{
  "name": "@avana/web",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "description": "The Avana web app: Lend, Borrow, Portfolio, market detail pages, Swap, Support and Ask AI, reading services/convex.",
  "engines": {
    "node": ">=22.12"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "browserslist": {
    "production": [
      "last 2 Chrome versions",
      "last 2 Edge versions",
      "last 2 Firefox versions",
      "last 2 Safari versions"
    ],
    "development": [
      "last 1 Chrome version"
    ]
  },
  "scripts": {
    "clean": "node scripts/clean-next.mjs",
    "dev": "node scripts/run-next.mjs dev",
    "dev:turbo": "node scripts/run-next.mjs dev --turbopack",
    "postinstall": "node scripts/patch-walletconnect-timeout.mjs",
    "prebuild": "node scripts/patch-walletconnect-timeout.mjs",
    "build": "node scripts/run-next.mjs build",
    "analyze": "ANALYZE=1 node scripts/run-next.mjs build",
    "dev:clean": "npm run clean && npm run dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:check": "node scripts/security-check.mjs",
    "pretest": "node scripts/patch-walletconnect-timeout.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:audit": "playwright test tests/e2e/app-audit.spec.ts",
    "test:e2e:browser-soak": "playwright test tests/e2e/browser-session-soak.spec.ts --project=chromium",
    "test:e2e:performance": "playwright test tests/e2e/route-performance.spec.ts",
    "perf:ssr-load": "node scripts/ssr-load-check.mjs",
    "test:e2e:update": "playwright test --update-snapshots",
    "start": "node scripts/run-next.mjs start",
    "lighthouse:budgets": "node scripts/lighthouse-budgets.mjs",
    "lighthouse:build": "AVANA_PERF_SOURCEMAPS=1 AVANA_NEXT_DIST_DIR=.next-lighthouse NEXT_PUBLIC_LIGHTHOUSE_AUDIT_MODE=1 NEXT_PUBLIC_LIGHTHOUSE_AUDIT_ARTIFACT=1 npm run build",
    "perf:bundle-budget": "node scripts/check-home-bundle-budget.mjs && node scripts/check-route-bundle-budgets.mjs",
    "lighthouse:serve": "AVANA_NEXT_DIST_DIR=.next-lighthouse NEXT_PUBLIC_LIGHTHOUSE_AUDIT_MODE=1 NEXT_PUBLIC_LIGHTHOUSE_AUDIT_ARTIFACT=1 npm run start -- --port 3001",
    "lighthouse:gpu": "LH_ENABLE_GPU=1 LH_OUTPUT_DIR=.artifacts/lighthouse-gpu npm run lighthouse:budgets",
    "lighthouse:analyze": "node scripts/analyze-lighthouse-bundles.mjs",
    "perf:instant-paint-baseline": "node scripts/instant-paint-baseline.mjs",
    "security:dependencies": "node scripts/dependency-baseline.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.15",
    "@convex-dev/agent": "0.7.0",
    "@emotion/is-prop-valid": "1.4.0",
    "@hugeicons/core-free-icons": "4.2.3",
    "@hugeicons/react": "1.1.9",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@sentry/nextjs": "10.78.0",
    "@tanstack/react-query": "5.101.4",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "connectkit": "1.9.2",
    "convex": "1.50.0",
    "framer-motion": "12.43.0",
    "lucide-react": "1.33.0",
    "next": "16.4.5",
    "radix-ui": "1.6.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "2.6.1",
    "tailwindcss-animate": "1.0.7",
    "viem": "2.57.11",
    "wagmi": "2.19.5",
    "web-vitals": "4.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/bundle-analyzer": "16.4.5",
    "@next/eslint-plugin-next": "16.4.5",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.8.0",
    "jsdom": "29.1.1",
    "lighthouse": "13.4.1",
    "postcss": "8.5.32",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "5.1.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.1"
  }
}
