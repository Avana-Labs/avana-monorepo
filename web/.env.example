# Environment of the Avana web app (web/). Copy to .env.local for local work; never commit real values.
# Variables marked (Convex) are set on the services/convex deployment, not in Next.js; they are listed here so one file
# names everything the app depends on.

# ---- Backend: services/convex ----
# Deployment URL of services/convex (https://<name>.convex.cloud). Without it every market list is empty and detail
# pages 404; `next build` still succeeds.
NEXT_PUBLIC_CONVEX_URL=
# HTTP actions origin of the same deployment (https://<name>.convex.site); added to the CSP connect-src.
NEXT_PUBLIC_CONVEX_SITE_URL=
# Server-side alias of NEXT_PUBLIC_CONVEX_URL used by some server reads (optional; defaults to the public URL).
CONVEX_URL=
# Shared secret of the SIWE route rate limiter (rateLimits.consume). Same value on the Convex deployment.
CONVEX_RATE_LIMIT_SECRET=

# ---- Chain ----
# The first target is the local anvil rehearsal deployment (chain 31337), read through the manifest loader in
# packages/protocol; Ethereum and Base follow through the same path. Contract calls are not wired yet, so the app reads
# no RPC URL today. These are reserved for that step:
NEXT_PUBLIC_AVANA_CHAIN_ID=31337
NEXT_PUBLIC_RPC_ANVIL=http://127.0.0.1:8545
NEXT_PUBLIC_RPC_MAINNET=
NEXT_PUBLIC_RPC_BASE=

# ---- Wallet connection ----
# WalletConnect / Reown project id (required for WalletConnect wallets; Coinbase Smart Wallet works without it).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- SIWE (optional sign-in for per-wallet features: synced preferences, support requests, Ask AI) ----
# Origin the app's JWTs are issued from; must equal SIWE_JWT_ISSUER on the Convex deployment exactly.
NEXT_PUBLIC_SIWE_ISSUER=http://localhost:3000
# RSA private JWK (JSON) that signs the session and Convex JWTs. Generate one per environment.
SIWE_JWT_PRIVATE_JWK=
# (Convex) Issuer Convex trusts; same value as NEXT_PUBLIC_SIWE_ISSUER.
SIWE_JWT_ISSUER=

# ---- Ask AI ----
# Secret that signs the limited guest JWT minted by /api/ask-ai/session.
ASK_AI_GUEST_SECRET=
# Feature flag of the Risk/Returns/Stress cards (off; they need wallet positions, not read yet).
NEXT_PUBLIC_ASK_AI_MODE_RUNS=
# (Convex) OpenAI key and models. Without the key Ask AI answers that it is unavailable.
OPENAI_API_KEY=
ASK_AI_MODEL=gpt-5.6-luna
ASK_AI_FAST_MODEL=
ASK_AI_MAX_OUTPUT_TOKENS=900
# (Convex) DefiLlama pools cache of Ask AI: endpoint override and how many top-TVL pools are cached (default 250).
ASK_AI_DEFILLAMA_POOLS_URL=
ASK_AI_DEFILLAMA_POOLS_LIMIT=

# ---- Monitoring and analytics ----
# Sentry public DSN (safe for the client). Sentry reports only from a Vercel deployment.
NEXT_PUBLIC_SENTRY_DSN=
# Source map upload token for CI builds (do not commit real tokens).
SENTRY_AUTH_TOKEN=
# Log INP beacons at /api/vitals.
ENABLE_WEB_VITALS_LOGS=

# ---- Development and tests (never set on production) ----
# Dev open gate: skip SIWE and act as a fixed test wallet (refused in production builds).
NEXT_PUBLIC_DEV_OPEN_GATE=
# Playwright mode (refused in production builds).
NEXT_PUBLIC_PLAYWRIGHT_TEST_MODE=
# Lighthouse audit build (local only).
NEXT_PUBLIC_LIGHTHOUSE_AUDIT_MODE=
NEXT_PUBLIC_LIGHTHOUSE_AUDIT_ARTIFACT=
# Isolated E2E deployment only.
AVANA_DEPLOYMENT_ENV=
AVANA_E2E_STAGING=
AVANA_E2E_PRIVATE_JWK=
AVANA_E2E_SESSION_SECRET=
# Alternative Next dist dir (performance tooling).
AVANA_NEXT_DIST_DIR=
